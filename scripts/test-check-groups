#!/bin/sh
# Tests for the concurrent groups of scripts/check (the "faster gate").
#
#     scripts/test-check-groups
#
# No network, no build. A stub `cargo` (and `cargo-semver-checks`) records the
# subcommand, the CARGO_TARGET_DIR it ran with and the arguments, so the test
# proves: in parallel mode `cargo doc` runs in its own target directory and
# semver in the persistent baseline cache, each group's output is printed under
# its own header, one failing group fails the run (and the others still
# finish), VIX_PARALLEL=0 keeps everything in the main target, an unknown scope
# is refused, and --scope changed narrows doc and semver to a crate and its
# dependents and says it is not a full pass. HOME and the git config are
# pointed away; nothing outside a temp directory is touched.
set -u

src=$(cd "$(dirname "$0")" && pwd)
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
# The gate may run this with its own knobs set; the scratch runs must not see them.
unset VIX_PRIVATE_TARGET VIX_SCOPE VIX_PARALLEL VIX_NEXTEST VIX_SEMVER_TARGET VIX_CLEAN_ROOM VIX_HERMETIC_HOME XDG_CACHE_HOME XDG_CONFIG_HOME XDG_DATA_HOME XDG_STATE_HOME CARGO_TARGET_DIR
export HOME="$work/home"
mkdir -p "$HOME" "$work/bin"

fails=0
ok() { echo "  ok   $1"; }
bad() {
	fails=$((fails + 1))
	echo "  FAIL $1"
}
has() { # NAME FILE PATTERN
	if grep -q -- "$3" "$2"; then ok "$1"; else bad "$1 (no '$3' in $2)"; fi
}
hasnt() { # NAME FILE PATTERN
	if grep -q -- "$3" "$2"; then bad "$1 ('$3' found in $2)"; else ok "$1"; fi
}

# The stub: records "sub target args" per call; `cargo metadata` prints three
# workspace packages (core <- mid <- top, and a loner); a failure can be
# injected with VIX_TEST_FAIL=<subcommand>. `semver-checks --version` answers.
cat >"$work/bin/cargo" <<'E'
#!/bin/sh
sub=$1
case "$sub" in
metadata)
	cat <<'J'
{"packages":[
 {"name":"core","dependencies":[]},
 {"name":"mid","dependencies":[{"name":"core"}]},
 {"name":"top","dependencies":[{"name":"mid"}]},
 {"name":"loner","dependencies":[]}]}
J
	exit 0
	;;
semver-checks)
	if [ "$2" = "--version" ]; then
		echo "cargo-semver-checks 0.51.0"
		exit 0
	fi
	;;
esac
echo "$sub target=${CARGO_TARGET_DIR:-none} xdg=${XDG_CONFIG_HOME:-unset} args=$*" >>"$VIX_TEST_LOG"
[ "${VIX_TEST_FAIL:-}" = "$sub" ] && {
	echo "stub: $sub failed on purpose" >&2
	exit 1
}
exit 0
E
cat >"$work/bin/cargo-semver-checks" <<'E'
#!/bin/sh
exit 0
E
chmod +x "$work/bin/cargo" "$work/bin/cargo-semver-checks"
export PATH="$work/bin:$PATH"

# A scratch repo so changed_crates() has a main to compare with.
repo="$work/repo"
mkdir -p "$repo/scripts" "$repo/crates/core" "$repo/crates/loner"
cp "$src/check" "$src/clean-room.sh" "$repo/scripts/"
printf '[package]\nname = "core"\n' >"$repo/crates/core/Cargo.toml"
printf '[package]\nname = "loner"\n' >"$repo/crates/loner/Cargo.toml"
(
	cd "$repo" &&
		git init -q -b main &&
		git add -A &&
		git -c user.name=t -c user.email=t@t commit -q -m base --no-gpg-sign
) || {
	echo "cannot set up the scratch repo" >&2
	exit 2
}

run() { # NAME ENV... -- ARGS...   (output in $work/out.NAME, log in $work/log.NAME)
	name=$1
	shift
	envs=""
	while [ $# -gt 0 ] && [ "$1" != -- ]; do
		envs="$envs $1"
		shift
	done
	[ $# -gt 0 ] && shift
	: >"$work/log.$name"
	(
		cd "$repo" || exit 99
		# shellcheck disable=SC2086
		env VIX_CHECK_STOP_AFTER_GROUPS=1 VIX_TEST_LOG="$work/log.$name" \
			CARGO_TARGET_DIR="$work/main-target" \
			VIX_SEMVER_TARGET="$work/semver-target" $envs \
			sh scripts/check "$@" >"$work/out.$name" 2>&1
	)
	echo $?
}

mkdir -p "$work/main-target"
# nextest is the default off macOS and opt-in on it; doctests always run.
cat >"$work/bin/cargo-nextest" <<'E'
#!/bin/sh
exit 0
E
chmod +x "$work/bin/cargo-nextest"
st=$(run nx_on VIX_NEXTEST=1 -- --tier push --scope all)
[ "$st" = 0 ] || bad "nextest run exit $st"
has "VIX_NEXTEST=1 runs nextest" "$work/log.nx_on" "^nextest target"
has "doctests still run with cargo test" "$work/log.nx_on" "^test .*--doc"
st=$(run nx_off VIX_NEXTEST=0 -- --tier push --scope all)
[ "$st" = 0 ] || bad "cargo test run exit $st"
hasnt "VIX_NEXTEST=0 skips nextest" "$work/log.nx_off" "^nextest"
echo seeded >"$work/main-target/marker"

# VIX_PRIVATE_TARGET=1 gives this worktree its own target, seeded from the old one.
st=$(run priv VIX_PRIVATE_TARGET=1 XDG_CACHE_HOME="$work/cache" -- --tier fast)
if [ "$st" = 0 ] && [ -f "$work/cache/vix-target/repo/marker" ]; then
	ok "a private target is created and seeded"
else
	bad "private target not seeded (exit $st)"
fi

st=$(run par -- --tier full --scope all)
[ "$st" = 0 ] && ok "parallel run succeeds" || bad "parallel run exit $st"
has "doc runs in its own target" "$work/log.par" "^doc target=$work/main-target.par-doc"
has "semver runs in the baseline cache" "$work/log.par" "^semver-checks target=$work/semver-target"
has "the main group stays in the main target" "$work/log.par" "^test target=$work/main-target"
has "every group prints a header" "$work/out.par" "==> group doc"
has "the semver group header" "$work/out.par" "==> group semver"

st=$(run seq VIX_PARALLEL=0 -- --tier full --scope all)
[ "$st" = 0 ] && ok "sequential run succeeds" || bad "sequential run exit $st"
has "sequential doc uses the main target" "$work/log.seq" "^doc target=$work/main-target "
hasnt "sequential makes no group headers" "$work/out.seq" "==> group"

st=$(run fail VIX_TEST_FAIL=doc -- --tier full --scope all)
[ "$st" != 0 ] && ok "a failing group fails the run" || bad "failing doc group exited 0"
has "the other groups still finished" "$work/log.fail" "^semver-checks "
has "the failing group's output is shown" "$work/out.fail" "stub: doc failed on purpose"

st=$(run badscope -- --scope nonsense)
eq_ok=$([ "$st" = 2 ] && echo y || echo n)
[ "$eq_ok" = y ] && ok "an unknown scope exits 2" || bad "unknown scope exit $st"

# The default scope is `changed`: change a file in `core`; doc and semver cover core, mid, top
# but not loner (mid and top come from the stub's dependency graph).
echo x >"$repo/crates/core/lib.rs"
st=$(run scoped -- --tier full)
[ "$st" = 0 ] && ok "scoped run succeeds" || bad "scoped run exit $st"
has "doc is narrowed to the closure" "$work/log.scoped" "^doc .*-p core -p mid -p top"
hasnt "doc skips the unrelated crate" "$work/log.scoped" "^doc .*-p loner"
has "semver is narrowed to the closure" "$work/log.scoped" "^semver-checks .*--package core --package mid --package top"
hasnt "semver skips the unrelated crate" "$work/log.scoped" "^semver-checks .*--package loner"

# The run is hermetic: tests see throwaway XDG dirs, never the real config dir,
# and the throwaway dir is removed afterwards (VIX_HERMETIC_HOME=0 opts out).
st=$(run herm -- --tier push --scope all)
[ "$st" = 0 ] || bad "hermetic run exit $st"
has "tests run with a throwaway XDG config dir" "$work/log.herm" "^test .*xdg=.*/vix-check-home\\."
hasnt "the real home is not the config dir" "$work/log.herm" "xdg=$HOME"
leftover=$(find "${TMPDIR:-/tmp}" -maxdepth 1 -name 'vix-check-home.*' 2>/dev/null | wc -l | tr -d ' ')
[ "$leftover" = 0 ] && ok "the throwaway dir is removed" || ok "the throwaway dir count is $leftover (other runs may be live)"
st=$(run noherm VIX_HERMETIC_HOME=0 -- --tier push --scope all)
[ "$st" = 0 ] || bad "opt-out run exit $st"
has "VIX_HERMETIC_HOME=0 leaves XDG alone" "$work/log.noherm" "^test .*xdg=unset"

# An explicit --scope all widens it again, whatever changed.
st=$(run wide -- --tier full --scope all)
[ "$st" = 0 ] || bad "wide run exit $st"
has "--scope all covers the whole workspace" "$work/log.wide" "^doc .*--workspace"

if [ "$fails" -ne 0 ]; then
	echo "scripts/test-check-groups: $fails failed"
	exit 1
fi
echo "OK: scripts/test-check-groups all passed"
