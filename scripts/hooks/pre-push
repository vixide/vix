#!/bin/sh
# pre-push hook (T761). Installed by `make hooks` (sets core.hooksPath).
#
# Refuses to push a branch or tag whose tip tree has no valid full-tier gate
# attestation (scripts/attest --verify). refs/heads/main and every tag are
# ALWAYS gated: nothing bypasses that here, and commit signing is never touched.
# Another branch may be pushed unattested with the explicit escape:
#
#   VIX_ALLOW_UNATTESTED=1 git push origin my-branch     (non-main branches only)
#
# An unattested push still runs the fast tier of the gate once (T833:
# `scripts/check --tier fast`: fmt, clippy and the tests of the crates changed
# since main) when the pushed commit is HEAD, since that is what the working
# tree holds; a failing fast tier refuses the push. Pushing another commit
# unattested prints that the fast tier was not run.
#
# Before that, the commits a pushed branch or tag would add (those no
# remote-tracking ref already has) go through scripts/secret-scan-history
# (T832), the history form of the pre-commit hook's secret scan, so a secret
# committed with --no-verify is caught before it leaves the machine. A finding
# refuses the push of that ref, on any branch and whatever the attestation; a
# scan that cannot run (exit 2) only warns.
#
# Deleting a ref, and pushing other refs (such as refs/notes/vix-gate), is not
# gated. `git push --no-verify` skips every hook; the forge's verify job is what
# catches that.
top=$(git rev-parse --show-toplevel) || exit 1
status=0
fast=""
head=$(git rev-parse --verify -q HEAD) || head=""
scan="$top/scripts/secret-scan-history"
while read -r _ local_sha remote_ref remote_sha; do
	case "$local_sha" in *[!0]*) ;; *) continue ;; esac
	case "$remote_ref" in
	refs/heads/* | refs/tags/*) ;;
	*) continue ;;
	esac
	if [ -x "$scan" ]; then
		# The commits this push adds: on no remote-tracking ref, and not behind
		# the remote's current tip when this clone has that commit.
		known=""
		case "$remote_sha" in *[!0]*)
			if git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then known=$remote_sha; fi
			;;
		esac
		"$scan" "$local_sha" --not --remotes ${known:+"$known"} </dev/null >/dev/null
		case $? in
		0) ;;
		1)
			echo "pre-push: refusing to push $remote_ref: a commit it adds holds what looks like a real secret (above)." >&2
			status=1
			continue
			;;
		*) echo "pre-push: the history secret scan could not run for $remote_ref (above); not checked." >&2 ;;
		esac
	fi
	if "$top/scripts/attest" --verify "$local_sha" >/dev/null 2>&1; then
		continue
	fi
	case "$remote_ref" in
	refs/heads/main | refs/tags/*)
		echo "pre-push: refusing to push $remote_ref: no valid full-tier attestation for $local_sha." >&2
		"$top/scripts/attest" --verify "$local_sha" >&2 || true
		echo "pre-push: run scripts/attest on a clean checkout of that commit (VIX_ALLOW_UNATTESTED does not apply to main or tags)." >&2
		status=1
		;;
	*)
		if [ "${VIX_ALLOW_UNATTESTED:-}" = 1 ]; then
			echo "pre-push: pushing $remote_ref UNATTESTED (VIX_ALLOW_UNATTESTED=1, non-main branch)." >&2
			if [ "$local_sha" != "$head" ]; then
				echo "pre-push: $remote_ref is not HEAD, so the fast tier was not run on it." >&2
			elif [ -z "$fast" ]; then
				echo "pre-push: running scripts/check --tier fast on the working tree..." >&2
				# </dev/null: the gate must not read the ref list on our stdin.
				if "$top/scripts/check" --tier fast </dev/null >&2; then
					fast=pass
				else
					fast=fail
				fi
			fi
			if [ "$local_sha" = "$head" ] && [ "$fast" = fail ]; then
				echo "pre-push: refusing to push $remote_ref: scripts/check --tier fast failed." >&2
				status=1
			fi
		else
			echo "pre-push: refusing to push $remote_ref: no valid full-tier attestation for $local_sha." >&2
			"$top/scripts/attest" --verify "$local_sha" >&2 || true
			echo "pre-push: run scripts/attest, or VIX_ALLOW_UNATTESTED=1 for a non-main branch." >&2
			status=1
		fi
		;;
	esac
done
exit $status
