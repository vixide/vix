#!/bin/sh
# Secret scan of git history (T832). Opt-in; never changes anything.
#
#     scripts/secret-scan-history [REVISION...]
#
# Runs the rules and the allowlist of scripts/secret-patterns (the file
# tui/tests/secret_scan.rs and scripts/hooks/pre-commit read, so the three
# cannot drift) over every line a commit added, as "git log -p" shows it.
# With no REVISION it scans everything ("--all": every branch, tag and other
# ref); otherwise the arguments are git log revisions, such as
# "main~50..main" or "HEAD --not --remotes". A merge commit is scanned as
# "--cc" shows it: only the lines its conflict resolution added, so a merge
# repeats nothing its parents already brought in. Renames are followed, so a
# renamed file is not reported again.
#
# Each finding is printed as "COMMIT PATH:LINE: RULE" (the line number is in
# that commit's version of the file), once per line, and the secret itself is
# never printed. A path on an allow line of scripts/secret-patterns is
# skipped in every commit.
#
# Exit status: 0 when nothing matched, 1 when something did, 2 on an error
# (not a git repository, an unknown revision, no pattern file). A finding is
# not removed by deleting the file in a later commit: revoke the credential;
# rewriting published history is a maintainer decision (docs/incident-response.md).
#
# scripts/hooks/pre-push runs it over the commits a push would add.
# scripts/test-secret-scan-history tests it in a throwaway repository.
set -u
case "${1:-}" in
-h | --help)
	sed -n '2,/^set -u/p' "$0" | sed '$d; s/^# \{0,1\}//'
	exit 0
	;;
esac
LC_ALL=C
export LC_ALL
patterns=$(dirname "$0")/secret-patterns
if [ ! -f "$patterns" ]; then
	echo "secret-scan-history: $patterns not found." >&2
	exit 2
fi
git rev-parse --git-dir >/dev/null 2>&1 || {
	echo "secret-scan-history: not inside a git repository." >&2
	exit 2
}
[ "$#" -gt 0 ] || set -- --all
if ! commits=$(git rev-list --count "$@" 2>/dev/null); then
	echo "secret-scan-history: git cannot list the revisions: $*" >&2
	exit 2
fi
tab=$(printf '\t')
work=$(mktemp -d) || exit 2
trap 'rm -rf "$work"' EXIT

# The rules, built as the pre-commit hook builds them.
: >"$work/rules"
: >"$work/eres"
: >"$work/allowed"
while IFS="$tab" read -r kind name accept before secret after; do
	case "$kind" in
	rule)
		ere="($secret)"
		[ "$before" = - ] || ere="(^|$before)$ere"
		[ "$after" = - ] || ere="$ere($|$after)"
		printf '%s\t%s\t%s\n' "$name" "$accept" "$ere" >>"$work/rules"
		printf '%s\n' "$ere" >>"$work/eres"
		;;
	allow) printf '%s\n' "$name" >>"$work/allowed" ;;
	esac
done <"$patterns"
if [ ! -s "$work/rules" ]; then
	echo "secret-scan-history: no rule lines in $patterns." >&2
	exit 2
fi

# Every added line's text goes to "added", one per line, and "where" gets a
# record "N<TAB>COMMIT<TAB>PATH<TAB>LINE" each time added line N does not
# simply continue the one before it (same commit and file, next line), so
# added line M >= N is at LINE + M - N.
git -c core.quotePath=false log --no-color --no-ext-diff --no-textconv \
	--src-prefix=a/ --dst-prefix=b/ -U0 -M --cc --format='commit %H' "$@" |
	awk -v where="$work/where" '
	/^commit [0-9a-f]+$/ { c = substr($0, 8); state = 0; next }
	/^diff / { state = 1; file = ""; next }
	/^@@/ && state > 0 {
		n = 0
		while (substr($0, n + 1, 1) == "@") n++
		np = n - 1
		ln = 0
		for (i = 2; i <= NF; i++) if ($i ~ /^[+][0-9]/) { split(substr($i, 2), a, ","); ln = a[1] + 0; break }
		state = 2
		next
	}
	state == 1 {
		if (substr($0, 1, 4) == "+++ ") {
			file = substr($0, 5)
			if (substr(file, 1, 2) == "b/") file = substr(file, 3)
		}
		next
	}
	state == 2 {
		pre = substr($0, 1, np)
		if (index(pre, "-") || index(pre, "\\")) next
		if (index(pre, "+") && file != "/dev/null") {
			out++
			if (c != lc || file != lf || ln != ll + 1) print out "\t" c "\t" file "\t" ln >where
			lc = c; lf = file; ll = ln
			print substr($0, np + 1)
		}
		ln++
	}' >"$work/added"
: >>"$work/where"

# The added lines some rule matches, then which rule matched each, as the
# pre-commit hook decides it.
grep -naE -f "$work/eres" "$work/added" >"$work/candidates"
cut -d: -f1 "$work/candidates" >"$work/numbers"
cut -d: -f2- "$work/candidates" >"$work/texts"
: >"$work/hits"
while IFS="$tab" read -r name accept ere; do
	grep -naoE -e "$ere" "$work/texts" >"$work/matches" || continue
	while IFS=: read -r k match; do
		if [ "$accept" = random ]; then
			body=${match#*-}
			case "$body" in *[0-9]*) ;; *) continue ;; esac
			case "$body" in *[A-Za-z]*) ;; *) continue ;; esac
		fi
		printf '%s\t%s\n' "$k" "$name" >>"$work/hits"
	done <"$work/matches"
done <"$work/rules"

# One report per added line (the first rule that matched it, in file order),
# skipping allowlisted paths; never the text of the line.
awk -F "$tab" '
	FILENAME == ARGV[1] { allowed[$0] = 1; next }
	FILENAME == ARGV[2] { if (!($1 in rule)) rule[$1] = $2; next }
	FILENAME == ARGV[3] { if (FNR in rule) { want[$0] = rule[FNR]; order[++wanted] = $0 } next }
	{ start[++ranges] = $1; commit[ranges] = $2; path[ranges] = $3; first[ranges] = $4 }
	END {
		r = 1
		for (w = 1; w <= wanted; w++) {
			n = order[w] + 0
			while (r < ranges && start[r + 1] <= n) r++
			if (path[r] in allowed) continue
			printf "  %s %s:%d: %s\n", substr(commit[r], 1, 12), path[r], first[r] + n - start[r], want[order[w]]
		}
	}' "$work/allowed" "$work/hits" "$work/numbers" "$work/where" >"$work/report"

if [ -s "$work/report" ]; then
	found=$(wc -l <"$work/report" | tr -d ' ')
	echo "secret-scan-history: $found added line(s) in history look like a real secret ($commits commit(s) scanned):" >&2
	cat "$work/report" >&2
	echo "secret-scan-history: revoke any that is real; a deliberate fake goes on an allow line in scripts/secret-patterns, with its reason." >&2
	exit 1
fi
echo "secret-scan-history: no secret found in $commits commit(s)."
