#!/bin/sh
# Tests for scripts/check-linux (T765). Throwaway: needs no Docker. Everything
# runs with VIX_CI_DRY_RUN=1 (the command is printed, never run), except the
# "no CLI" and "daemon down" cases, which use a stub CLI on a private PATH.
#
#     scripts/test-check-linux
set -u

src=$(cd "$(dirname "$0")" && pwd)
root=$(dirname "$src")
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

fails=0
ok() { echo "  ok   $1"; }
bad() {
	fails=$((fails + 1))
	echo "  FAIL $1"
	[ -f "$work/out" ] && sed 's/^/       /' "$work/out"
}
pass() {
	name=$1
	shift
	if "$@" >"$work/out" 2>&1; then ok "$name"; else bad "$name"; fi
}
fail() {
	name=$1
	shift
	if "$@" >"$work/out" 2>&1; then bad "$name (unexpectedly passed)"; else ok "$name"; fi
}
has() {
	if grep -q -- "$1" "$work/out"; then ok "output has '$1'"; else bad "output has '$1'"; fi
}
lacks() {
	if grep -q -- "$1" "$work/out"; then bad "output lacks '$1'"; else ok "output lacks '$1'"; fi
}

cd "$root" || exit 1
s=scripts/check-linux

echo "== arguments"
fail "unknown argument" "$s" --nonsense
has "unknown argument"
fail "unknown tier" "$s" --tier bogus
has "unknown tier"
fail "--tier needs a value" "$s" --tier
has "needs a value"
pass "help exits 0" "$s" --help
has "usage:"

echo "== dry run"
export VIX_CI_DRY_RUN=1
pass "default tier is push" "$s"
has "scripts/check --tier push"
pass "--tier fast" "$s" --tier fast
has "scripts/check --tier fast"
pass "--tier=full" "$s" --tier=full
has "scripts/check --tier full"
pass "--shell" "$s" --shell
has "run --rm -it"
has "exec bash"
lacks "scripts/check --tier"

echo "== generated command"
msrv=$(sed -n 's/^rust-version *= *"\([0-9.]*\)".*/\1/p' Cargo.toml | head -n 1)
# The toolchain is the host's rustc (a stub here, so the test does not depend
# on what is installed), and the MSRV only when there is no rustc at all.
mkdir -p "$work/rustc" "$work/norustc"
printf '#!/bin/sh\necho "rustc 1.98.3 (0123abcd 2026-10-01)"\n' >"$work/rustc/rustc"
chmod +x "$work/rustc/rustc"
pass "the toolchain follows the host rustc" env PATH="$work/rustc:/usr/bin:/bin" "$s"
has "FROM rust:1.98.3-bookworm"
has "vix-check-linux:1.98.3"
pass "no host rustc: the MSRV" env PATH="$work/norustc:/usr/bin:/bin" "$s"
has "FROM rust:$msrv-bookworm"
pass "command" "$s"
has "rustup component add clippy rustfmt"
has "-v $root:/src:ro"
has "vix-check-linux-work:/cache/work"
has "vix-check-linux-target:/cache/target"
has "vix-check-linux-cargo:/cache/cargo"
has "--user [0-9]*:[0-9]*"
lacks "--user 0:0"
lacks "--user root"
has "--pull=never"
has "--cap-drop ALL"
has "no-new-privileges"
has "RUSTC_WRAPPER="
lacks "\.ssh"
lacks "docker\.sock"
lacks "\.gitconfig"
lacks "--privileged"
lacks "--network host"
lacks "AWS_\|GITHUB_TOKEN\|SSH_AUTH_SOCK"
lacks "-v $HOME:"
# Exactly one bind mount, and it is the repository, read-only.
n=$(grep -o -- ' -v /[^ ]*' "$work/out" | wc -l | tr -d ' ')
[ "$n" = 1 ] && ok "one bind mount" || bad "one bind mount (got $n)"
n=$(grep -o -- ' -v /[^ ]*' "$work/out" | grep -c -- ':/src:ro')
[ "$n" = 1 ] && ok "the bind mount is read-only" || bad "the bind mount is read-only"
VIX_LINUX_RUST=1.99.1 pass "VIX_LINUX_RUST overrides" "$s"
has "FROM rust:1.99.1-bookworm"
VIX_LINUX_IMAGE=my/image:1 pass "VIX_LINUX_IMAGE overrides the tag" "$s"
has "my/image:1 sh -c"
VIX_CONTAINER_CLI=podman pass "VIX_CONTAINER_CLI" "$s"
has "^podman run"
pass "VIX_LINUX_JOBS sets the cargo jobs" env VIX_LINUX_JOBS=3 "$s"
has "-e CARGO_BUILD_JOBS=3 "
fail "VIX_LINUX_JOBS must be a number" env VIX_LINUX_JOBS=many "$s"
has "positive number"
fail "VIX_LINUX_JOBS must be positive" env VIX_LINUX_JOBS=0 "$s"
# The default: one job per 3 GiB of the engine's memory, at most one per CPU,
# read from `info` (Docker's template first, then Podman's).
mkdir -p "$work/bin"
printf '#!/bin/sh\ncase "$*" in *Host.*) echo "8589934592 8" ;; *) exit 1 ;; esac\n' >"$work/bin/podinfo"
printf '#!/bin/sh\necho "34359738368 6"\n' >"$work/bin/bigvm"
chmod +x "$work/bin/podinfo" "$work/bin/bigvm"
pass "jobs from Podman's memory" env PATH="$work/bin:$PATH" VIX_CONTAINER_CLI=podinfo "$s"
has "-e CARGO_BUILD_JOBS=2 "
pass "jobs capped at the CPUs" env PATH="$work/bin:$PATH" VIX_CONTAINER_CLI=bigvm "$s"
has "-e CARGO_BUILD_JOBS=6 "
pass "no engine to ask: cargo's default" env VIX_CONTAINER_CLI=vix-no-such-cli "$s"
lacks "CARGO_BUILD_JOBS"

echo "== real mode (stub CLI, no Docker needed)"
unset VIX_CI_DRY_RUN
mkdir -p "$work/bin"
fail "no container CLI is a clear failure" env PATH="$work/bin:/usr/bin:/bin" VIX_CONTAINER_CLI=vix-no-such-cli "$s"
has "no container CLI"
has "colima"
has "orbstack"
printf '#!/bin/sh\n[ "$1" = info ] && exit 1\nexit 0\n' >"$work/bin/stub"
chmod +x "$work/bin/stub"
fail "daemon down is a clear failure" env PATH="$work/bin:/usr/bin:/bin" VIX_CONTAINER_CLI=stub "$s"
has "daemon is not reachable"
has "colima start"

# A buildx builder (its `build --help` lists --load) that loads the result into
# the image store only when asked, as the docker-container driver does. A stale
# image of the same tag already exists, so an `image inspect` cannot tell: the
# script must pass --load up front, then run with --pull=never. The stub logs
# every call and keeps the "image" as a file holding its build flags.
cat >"$work/bin/stub" <<'STUB'
#!/bin/sh
case "$1 $2" in "build --help") echo "${STUB_HELP:-}"; exit 0 ;; esac
echo "$*" >>"$STUB_LOG"
case "$1" in
info) exit 0 ;;
build)
	cat >/dev/null
	case " $* " in *" --load "*) echo loaded >"$STUB_IMAGE" ;; esac
	[ -z "${STUB_ALWAYS_LOADS:-}" ] || echo loaded >"$STUB_IMAGE"
	exit 0
	;;
image) [ -f "$STUB_IMAGE" ] ;;
run) exit 0 ;;
esac
STUB
chmod +x "$work/bin/stub"
stub_env() { env PATH="$work/bin:/usr/bin:/bin" VIX_CONTAINER_CLI=stub STUB_LOG="$work/log" STUB_IMAGE="$work/image" "$@"; }
echo stale >"$work/image"
pass "buildx gets --load" stub_env STUB_HELP="      --load   Shorthand for --output=type=docker" "$s"
cp "$work/log" "$work/out"
has "^build -q --load -t"
has "^run --rm --pull=never"
[ "$(cat "$work/image")" = loaded ] && ok "the stale image was replaced" || bad "the stale image was replaced"
# Podman or the legacy builder: no --load in its help (it would reject the
# flag), and it always loads.
rm -f "$work/log" "$work/image"
pass "a builder without --load gets none" stub_env STUB_ALWAYS_LOADS=1 "$s"
cp "$work/log" "$work/out"
has "^build -q -t"
lacks "--load"
has "^run --rm --pull=never"
# A builder that never leaves the image: a clear failure, and no run.
rm -f "$work/log" "$work/image"
fail "an image that never appears is a clear failure" stub_env "$s"
has "did not leave"
cp "$work/log" "$work/out"
lacks "^run"

echo
if [ "$fails" -eq 0 ]; then
	echo "scripts/test-check-linux: all checks passed"
else
	echo "scripts/test-check-linux: $fails check(s) FAILED"
	exit 1
fi
