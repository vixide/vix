{
  "name": "vixide.github.io",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "=26"
  },
  "packageManager": "pnpm@11.28.9",
  "scripts": {
    "themes": "node scripts/copy-lily-themes.js",
    "dev": "node scripts/copy-lily-themes.js && vite dev",
    "build": "node scripts/copy-lily-themes.js && vite build",
    "preview": "vite preview",
    "check:i18n": "node scripts/check-i18n.js",
    "check": "node scripts/check-i18n.js && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.2.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "syncpack": "^15.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@lilydesignsystem/svelte-headless": "^0.9.0",
    "@lilydesignsystem/svelte-picker-bar": "^0.6.0",
    "@lilydesignsystem/svelte-share-picker": "^0.3.2",
    "@lilydesignsystem/svelte-theme-picker": "^0.4.0",
    "@lilydesignsystem/themes": "^0.6.2"
  },
  "license": "Apache-2.0 OR BSD-3-Clause OR MIT OR GPL-2.0-only OR GPL-3.0-only",
  "author": "Joel Parker Henderson <joel@joelparkerhenderson.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vixide/vixide.github.io.git"
  },
  "homepage": "https://vixide.github.io/",
  "bugs": {
    "url": "https://github.com/vixide/vix/issues"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
